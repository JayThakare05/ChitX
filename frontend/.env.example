# Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── Backend API ─────────────────────────────────────────────────────────────
# Base URL for the Node.js backend server
VITE_API_URL=http://localhost:5000

# ── AI Service ──────────────────────────────────────────────────────────────
# Base URL for the Python FastAPI AI Oracle
VITE_AI_URL=http://localhost:8000

# ── Wallet Connect / RainbowKit ─────────────────────────────────────────────
# Get your free Project ID from: https://cloud.reown.com/
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# ── Blockchain ──────────────────────────────────────────────────────────────
# CTX Token contract address (Sepolia testnet)
VITE_CTX_ADDRESS=0x3F78A5476539BfBD529FfEA0e713f887141412e3
# ChitPool treasury address
VITE_TREASURY_ADDRESS=0x95e9943BB6F8B301Fa465e698a5aAc435DB48C39
